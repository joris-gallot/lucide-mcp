{
  "name": "lucide-mcp",
  "version": "0.2.0",
  "description": "MCP server for searching and retrieving Lucide SVG icons.",
  "type": "module",
  "bin": {
    "lucide-mcp": "dist/index.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && chmod +x dist/index.mjs",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "pnpm typecheck && pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "lucide",
    "icons",
    "svg",
    "ai"
  ],
  "author": "Joris Gallot",
  "license": "MIT",
  "homepage": "https://github.com/joris-gallot/lucide-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joris-gallot/lucide-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/joris-gallot/lucide-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "fuse.js": "^7.5.0",
    "lucide-static": "^1.31.0",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=26",
    "pnpm": "11.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  }
}
